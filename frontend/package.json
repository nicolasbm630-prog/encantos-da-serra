{
  "name": "encantos-da-serra-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "rm -rf dist && bun build ./index.html --outdir dist --production --public-path=/ && cp -R public/. dist/",
    "start": "NODE_ENV=production bun server.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
